func {{$r.LowerCamel}}JSONNull(raw json.RawMessage) bool {
	return bytes.Equal(bytes.TrimSpace(raw), []byte("null"))
}

{{- if $r.HasNestedCollections}}
func {{$r.LowerCamel}}NestedConfigRaw(parent json.RawMessage, name string) json.RawMessage {
	if len(parent) == 0 || {{$r.LowerCamel}}JSONNull(parent) {
		return nil
	}
	var object map[string]json.RawMessage
	if err := json.Unmarshal(parent, &object); err != nil || object == nil {
		return nil
	}
	return object[name]
}

{{- end}}
// RejectItemNullUnlessNullable reports a malformed-result diagnostic when a
// collection-item field is present in the remote response as an explicit JSON
// null but the pinned schema does not mark the field nullable. A missing key
// is not rejected here (optional omission is handled by the decode helpers).
func {{$r.LowerCamel}}RejectItemNullUnlessNullable(object map[string]json.RawMessage, key string, allowNull bool, location string, diagnostics *diag.Diagnostics) {
	raw, ok := object[key]
	if !ok {
		return
	}
	if {{$r.LowerCamel}}JSONNull(raw) && !allowNull {
		diagnostics.AddError("Malformed {{$r.OperationName}} result", location+" "+key+" was null, which the pinned schema does not mark nullable.")
	}
}

{{- range .Resource.ScalarStringArrays}}
func {{$r.LowerCamel}}ValidateConfigured{{.GoName}}(ctx context.Context, wrapper types.Object) diag.Diagnostics {
	var diagnostics diag.Diagnostics
	if wrapper.IsNull() || wrapper.IsUnknown() {
		return diagnostics
	}
	var model struct {
		Items types.List `tfsdk:"item"`
	}
	diagnostics.Append(wrapper.As(ctx, &model, basetypes.ObjectAsOptions{})...)
	if diagnostics.HasError() || model.Items.IsNull() || model.Items.IsUnknown() {
		return diagnostics
	}
	{{- if .MaxItemsVar}}
	if len(model.Items.Elements()) > {{.MaxItemsVar}} {
		diagnostics.AddError("Invalid {{$r.OperationName}} {{.WireName}}", fmt.Sprintf("{{.WireName}} may contain at most %d item blocks.", {{.MaxItemsVar}}))
		return diagnostics
	}
	{{- end}}
	var items []{{.LocalName}}ItemModel
	diagnostics.Append(model.Items.ElementsAs(ctx, &items, false)...)
	if diagnostics.HasError() {
		return diagnostics
	}
	for index, item := range items {
		location := fmt.Sprintf("{{.WireName}} item %d", index+1)
		if item.{{.ItemGoName}}.IsNull() {
			diagnostics.AddError("Invalid {{$r.OperationName}} {{.WireName}}", location+" {{.ItemAttribute}} is required.")
		{{- if .EnumMap}}
		} else if !item.{{.ItemGoName}}.IsUnknown() && !{{.EnumValid}}(item.{{.ItemGoName}}.ValueString()) {
			diagnostics.AddError("Invalid {{$r.OperationName}} {{.WireName}}", location+" {{.ItemAttribute}} must be one of {{enumProse .Enum}}.")
		{{- end}}
		}
	}
	return diagnostics
}

func {{$r.LowerCamel}}BuildConfigured{{.GoName}}(ctx context.Context, configured, planned types.Object, diagnostics diag.Diagnostics) ({{.LocalName}}OwnedList, diag.Diagnostics) {
	if configured.IsNull() {
		return {{.LocalName}}OwnedList{}, diagnostics
	}
	if configured.IsUnknown() {
		diagnostics.AddError("Unknown {{$r.OperationName}} {{.WireName}}", "The {{.WireName}} ownership wrapper must be known during apply.")
		return {{.LocalName}}OwnedList{}, diagnostics
	}
	if planned.IsNull() || planned.IsUnknown() {
		diagnostics.AddError("Unknown {{$r.OperationName}} {{.WireName}}", "The planned {{.WireName}} ownership wrapper must be known during apply.")
		return {{.LocalName}}OwnedList{}, diagnostics
	}
	var configWrapper, planWrapper struct {
		Items types.List `tfsdk:"item"`
	}
	diagnostics.Append(configured.As(ctx, &configWrapper, basetypes.ObjectAsOptions{})...)
	diagnostics.Append(planned.As(ctx, &planWrapper, basetypes.ObjectAsOptions{})...)
	if diagnostics.HasError() {
		return {{.LocalName}}OwnedList{}, diagnostics
	}
	if configWrapper.Items.IsUnknown() || planWrapper.Items.IsUnknown() {
		diagnostics.AddError("Unknown {{$r.OperationName}} {{.WireName}}", "The {{.WireName}} item blocks must be known during apply.")
		return {{.LocalName}}OwnedList{}, diagnostics
	}
	if configWrapper.Items.IsNull() {
		return {{.LocalName}}OwnedList{Set: true, Items: []string{}}, diagnostics
	}
	var configItems, planItems []{{.LocalName}}ItemModel
	diagnostics.Append(configWrapper.Items.ElementsAs(ctx, &configItems, false)...)
	if planWrapper.Items.IsNull() {
		if len(configItems) != 0 {
			diagnostics.AddError("Invalid {{$r.OperationName}} {{.WireName}}", "The planned item list unexpectedly became null.")
		}
		return {{.LocalName}}OwnedList{Set: true, Items: []string{}}, diagnostics
	}
	diagnostics.Append(planWrapper.Items.ElementsAs(ctx, &planItems, false)...)
	if diagnostics.HasError() {
		return {{.LocalName}}OwnedList{}, diagnostics
	}
	if len(configItems) != len(planItems) {
		diagnostics.AddError("Invalid {{$r.OperationName}} {{.WireName}}", "Configured and planned item counts differ.")
		return {{.LocalName}}OwnedList{}, diagnostics
	}
	{{- if .MaxItemsVar}}
	if len(configItems) > {{.MaxItemsVar}} {
		diagnostics.AddError("Invalid {{$r.OperationName}} {{.WireName}}", fmt.Sprintf("{{.WireName}} may contain at most %d item blocks.", {{.MaxItemsVar}}))
		return {{.LocalName}}OwnedList{}, diagnostics
	}
	{{- end}}
	items := make([]string, 0, len(configItems))
	for index := range configItems {
		configuredItem := configItems[index]
		plannedItem := planItems[index]
		location := fmt.Sprintf("{{.WireName}} item %d", index+1)
		if configuredItem.{{.ItemGoName}}.IsNull() {
			diagnostics.AddError("Invalid {{$r.OperationName}} {{.WireName}}", "The required "+location+" {{.ItemAttribute}} is null.")
			continue
		}
		value := ""
		if configuredItem.{{.ItemGoName}}.IsUnknown() {
			if plannedItem.{{.ItemGoName}}.IsNull() || plannedItem.{{.ItemGoName}}.IsUnknown() {
				diagnostics.AddError("Unknown {{$r.OperationName}} {{.WireName}}", "The configured "+location+" {{.ItemAttribute}} is still unknown during apply.")
				continue
			}
			value = plannedItem.{{.ItemGoName}}.ValueString()
		} else {
			value = configuredItem.{{.ItemGoName}}.ValueString()
		}
		{{- if .EnumMap}}
		if !{{.EnumValid}}(value) {
			diagnostics.AddError("Invalid {{$r.OperationName}} {{.WireName}}", location+" {{.ItemAttribute}} must be one of {{enumProse .Enum}}.")
		}
		{{- end}}
		items = append(items, value)
	}
	return {{.LocalName}}OwnedList{Set: true, Items: items}, diagnostics
}

func {{$r.LowerCamel}}Decode{{.GoName}}(raw json.RawMessage) ([]string, diag.Diagnostics) {
	var diagnostics diag.Diagnostics
	{{- if .Required}}
	if len(raw) == 0 {
		diagnostics.AddError("Malformed {{$r.OperationName}} result", "The successful API result did not contain the required {{.WireName}} array.")
		return nil, diagnostics
	}
	{{- else}}
	if len(raw) == 0 {
		return []string{}, diagnostics
	}
	{{- end}}
	if {{$r.LowerCamel}}JSONNull(raw) {
		diagnostics.AddError("Malformed {{$r.OperationName}} result", "The successful API result contained null {{.WireName}} instead of an array.")
		return nil, diagnostics
	}
	var rawItems []json.RawMessage
	if err := json.Unmarshal(raw, &rawItems); err != nil {
		diagnostics.AddError("Malformed {{$r.OperationName}} result", "The successful API result contained a non-array {{.WireName}} value.")
		return nil, diagnostics
	}
	{{- if .MaxItemsVar}}
	if len(rawItems) > {{.MaxItemsVar}} {
		diagnostics.AddError("Malformed {{$r.OperationName}} result", fmt.Sprintf("The successful API result contained more than %d {{.WireName}} items.", {{.MaxItemsVar}}))
		return nil, diagnostics
	}
	{{- end}}
	items := make([]string, 0, len(rawItems))
	for position, rawItem := range rawItems {
		location := fmt.Sprintf("{{.WireName}} item %d", position+1)
		if {{$r.LowerCamel}}JSONNull(rawItem) {
			diagnostics.AddError("Malformed {{$r.OperationName}} result", location+" was null instead of a string.")
			continue
		}
		var value string
		if err := json.Unmarshal(rawItem, &value); err != nil {
			diagnostics.AddError("Malformed {{$r.OperationName}} result", location+" was not a string.")
			continue
		}
		{{- if .EnumMap}}
		if !{{.EnumValid}}(value) {
			diagnostics.AddError("Malformed {{$r.OperationName}} result", location+" was not one of {{enumProse .Enum}}.")
			continue
		}
		{{- end}}
		items = append(items, value)
	}
	if diagnostics.HasError() {
		return nil, diagnostics
	}
	return items, diagnostics
}

func {{$r.LowerCamel}}{{.GoName}}WrapperValue(items []string) (types.Object, diag.Diagnostics) {
	var diagnostics diag.Diagnostics
	elements := make([]attr.Value, 0, len(items))
	for _, item := range items {
		object, objectDiagnostics := types.ObjectValue({{.LocalName}}ItemAttributeTypes, map[string]attr.Value{"{{.ItemAttribute}}": types.StringValue(item)})
		diagnostics.Append(objectDiagnostics...)
		elements = append(elements, object)
	}
	list, listDiagnostics := types.ListValue(types.ObjectType{AttrTypes: {{.LocalName}}ItemAttributeTypes}, elements)
	diagnostics.Append(listDiagnostics...)
	wrapper, wrapperDiagnostics := types.ObjectValue({{.LocalName}}WrapperAttributeTypes, map[string]attr.Value{"item": list})
	diagnostics.Append(wrapperDiagnostics...)
	return wrapper, diagnostics
}
