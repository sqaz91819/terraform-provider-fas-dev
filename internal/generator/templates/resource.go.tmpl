				{{- end}}
			},
			{{- end}}
			Reason:   "{{$r.TemplateDestroyReason}}",
		},
	}
}

func ({{$r.LowerCamel}}Codec) Schema(context.Context) schema.Schema {
	{{- if $r.NeedsStringStateModifier}}
	stringStateModifier := []planmodifier.String{stringplanmodifier.UseStateForUnknown()}
	{{- end}}
	{{- if $r.NeedsBoolStateModifier}}
	boolStateModifier := []planmodifier.Bool{boolplanmodifier.UseStateForUnknown()}
	{{- end}}
	{{- if $r.NeedsInt64StateModifier}}
	int64StateModifier := []planmodifier.Int64{int64planmodifier.UseStateForUnknown()}
	{{- end}}
	{{- if $r.HasCollections}}
	ownershipWrapper := func(name string, maxItems int, unindexed bool, attributes map[string]schema.Attribute, blocks map[string]schema.Block) schema.SingleNestedBlock {
		orderDesc := "Complete ordered {{$r.OperationName}} " + name + " items. Terraform order controls generated one-based indices."
		if unindexed {
			orderDesc = "Complete ordered {{$r.OperationName}} " + name + " items in Terraform order. This collection has no positional idx."
		}
		boundedItemBlock := schema.ListNestedBlock{
			MarkdownDescription: orderDesc,
			NestedObject: schema.NestedBlockObject{
				Attributes: attributes,
				Blocks:     blocks,
			},
		}
		if maxItems > 0 {
			boundedItemBlock.Validators = []validator.List{listvalidator.SizeAtMost(maxItems)}
		}
		return schema.SingleNestedBlock{
			MarkdownDescription: "Optional " + name + " ownership wrapper. Omit it to preserve the raw remote array; use an empty wrapper to replace the array with [].",
			Blocks: map[string]schema.Block{
				"item": boundedItemBlock,
			},
		}
	}
	{{- end}}
	{{- range .Resource.ScalarStringArrays}}
	{{.LocalName}}ItemBlock := schema.ListNestedBlock{
		MarkdownDescription: "Allowed {{$r.OperationName}} {{.WireName}} string values in Terraform order.",
		{{- if .MaxItemsVar}}
		Validators: []validator.List{listvalidator.SizeAtMost({{.MaxItemsVar}})},
		{{- end}}
		NestedObject: schema.NestedBlockObject{
			Attributes: map[string]schema.Attribute{
				"{{.ItemAttribute}}": schema.StringAttribute{
					Required:            true,
					MarkdownDescription: {{if .Enum}}"One of the reviewed {{.WireName}} enum values."{{else}}"A reviewed string value."{{end}},
					{{- if .Enum}}
					Validators:          []validator.String{stringvalidator.OneOf({{enumOneOfArgs .Enum}})},
					{{- end}}
				},
			},
		},
	}
	{{- end}}
	{{- range .Resource.ScalarStringArrays}}
	{{.LocalName}}Wrapper := schema.SingleNestedBlock{
		MarkdownDescription: "Optional {{.WireName}} ownership wrapper. Omit it to preserve the raw remote array; use an empty wrapper to replace the array with [].",
		Blocks: map[string]schema.Block{
			"item": {{.LocalName}}ItemBlock,
		},
	}
	{{- end}}

	return schema.Schema{
		MarkdownDescription: "Manages app-level FortiAppSec Cloud {{$r.OperationName}}. {{if $r.DestroyDisables}}Destroy disables the remote module with a preserving GET-merge-PUT-GET lifecycle.{{else}}Destroy forgets state without changing the remote module.{{end}}",
		Attributes: map[string]schema.Attribute{
			"ep_id": schema.StringAttribute{
				Required:            true,
				MarkdownDescription: "Application endpoint ID and import identifier.",
				PlanModifiers:       []planmodifier.String{stringplanmodifier.RequiresReplace()},
			},
			"template": schema.BoolAttribute{
				Required:            true,
				MarkdownDescription: "Whether effective {{$r.OperationName}} configuration is inherited from the attached template.",
			},
		},
		Blocks: map[string]schema.Block{
			"configs": schema.SingleNestedBlock{
				MarkdownDescription: "Locally managed {{$r.OperationName}} configuration. Required when template is false and omitted when template is true.",
				Attributes: map[string]schema.Attribute{
					{{- range .Resource.Scalars}}
					{{- if not (eq .Kind "object")}}
					"{{.Name}}": {{.SchemaExpr}},
					{{- end}}
					{{- end}}
				},
				Blocks: map[string]schema.Block{
					{{- range .Resource.Scalars}}
					{{- if eq .Kind "object"}}
					"{{.Name}}": {{.SchemaExpr}},
					{{- end}}
					{{- end}}
					{{- range .Resource.Collections}}
{{$coll := .}}
					"{{.WireName}}": ownershipWrapper("{{.WireName}}", {{.MaxItems}}, {{.Unindexed}}, map[string]schema.Attribute{
						{{- range .Item.Fields}}
						{{- if and (not .ObjectFields) (not .SubItemArray) (not .ItemScalarStringArray)}}
						"{{.Name}}": {{.SchemaExpr}},
						{{- end}}
						{{- end}}
					}, map[string]schema.Block{
						{{- range .Item.Fields}}
						{{- if or .ObjectFields (or .SubItemArray .ItemScalarStringArray)}}
						"{{.Name}}": {{.SchemaExpr}},
						{{- end}}
						{{- end}}
					}),
					{{- end}}
					{{- range .Resource.ScalarStringArrays}}
					"{{.WireName}}": {{.LocalName}}Wrapper,
					{{- end}}
				},
			},
		},
