func {{$r.LowerCamel}}Descriptor() wafmodule.Descriptor {
	return wafmodule.Descriptor{
		TypeNameSuffix: "{{$r.TypeNameSuffix}}",
		Endpoint: client.WAFModuleEndpoint{
			Path:      "{{$r.GetPath}}",
			Operation: "{{$r.OperationName}}",
		},
		Codec: {{$r.LowerCamel}}Codec{},
		Destroy: wafmodule.DestroyPolicy{
			Mode:     wafmodule.Destroy{{$r.DestroyModeGo}},
			Verified: {{$r.DestroyVerified}},
			Field:    "{{$r.DestroyField}}",
			Reason:   "{{$r.DestroyReason}}",
		},
	}
}

func {{$r.LowerCamel}}TemplateDescriptor() wafmodule.TemplateDescriptor {
	return wafmodule.TemplateDescriptor{
		TypeNameSuffix: "waf_template_{{trimWAFPrefix $r.TypeNameSuffix}}",
		Endpoint: client.WAFTemplateModuleEndpoint{
			Path:      "{{$r.TemplateGetPath}}",
			Operation: "{{$r.OperationName}}",
		},
		Codec: {{$r.LowerCamel}}Codec{},
		Destroy: wafmodule.DestroyPolicy{
			Mode:     wafmodule.Destroy{{$r.TemplateDestroyModeGo}},
			Verified: {{$r.TemplateDestroyVerified}},
			Field:    "{{$r.TemplateDestroyField}}",
