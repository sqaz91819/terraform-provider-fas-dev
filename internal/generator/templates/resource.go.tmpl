func (patch {{$r.LowerCamel}}Patch) Apply(_ context.Context, result *client.WAFModuleResult) diag.Diagnostics {
	var diagnostics diag.Diagnostics
	if result == nil {
		diagnostics.AddError("Unable to merge {{$r.OperationName}} configuration", "The current API result was nil.")
		return diagnostics
	}
	set := func(name string, value any) {
		if err := result.SetConfig(name, value); err != nil {
			diagnostics.AddError("Unable to merge {{$r.OperationName}} configuration", fmt.Sprintf("Unable to encode %s: %v", name, err))
		}
	}
	{{- if $r.HasNestedCollections}}
	setNested := func(parent, name string, value any) {
		object := make(map[string]json.RawMessage)
		if raw := result.Configs[parent]; len(raw) > 0 && !{{$r.LowerCamel}}JSONNull(raw) {
			if err := json.Unmarshal(raw, &object); err != nil || object == nil {
				diagnostics.AddError("Unable to merge {{$r.OperationName}} configuration", fmt.Sprintf("Unable to decode nested config object %s.", parent))
				return
			}
		}
		encoded, err := json.Marshal(value)
		if err != nil {
			diagnostics.AddError("Unable to merge {{$r.OperationName}} configuration", fmt.Sprintf("Unable to encode %s.%s: %v", parent, name, err))
			return
		}
		object[name] = encoded
		set(parent, object)
	}
	{{- end}}
	{{- range .Resource.Scalars}}
	{{- if not .ComputedOnly}}
	if patch.{{.GoName}}.Set {
		set("{{.Name}}", patch.{{.GoName}}.Value)
	}
	{{- end}}
	{{- end}}
	{{- range .Resource.Collections}}
{{$coll := .}}
	if patch.{{.GoName}}.Set {
		{{- if or (.Item.Fields | hasSubItemArray) (.Item.Fields | hasItemStringArray)}}
		// Merge preserved nested sub-item arrays / item string-arrays from the
		// fresh GET into a per-attempt clone of the patch items. This ensures
		// opaque preservation (the PUT carries the fresh GET's nested raw
		// value, including unknown keys and null) and is safe across 409
		// retries (the original patch is not mutated; the clone is rebuilt
		// from each fresh GET).
		{{$coll.LocalName}}GetRaw := {{if .WireParent}}{{$r.LowerCamel}}NestedConfigRaw(result.Configs["{{.WireParent}}"], "{{.WireName}}"){{else}}result.Configs["{{.WireName}}"]{{end}}
		{{$coll.LocalName}}PatchItems := make([]{{.CodecPrefix}}WireItem, len(patch.{{.GoName}}.Items))
		copy({{$coll.LocalName}}PatchItems, patch.{{.GoName}}.Items)
		if len({{$coll.LocalName}}GetRaw) > 0 && !{{$r.LowerCamel}}JSONNull({{$coll.LocalName}}GetRaw) {
			var {{$coll.LocalName}}GetItems []map[string]json.RawMessage
			if err := json.Unmarshal({{$coll.LocalName}}GetRaw, &{{$coll.LocalName}}GetItems); err == nil {
				// Preserve omitted nested arrays by matching each patch item to a
				// unique unconsumed fresh-GET item by its "unchanged projection"
				// (canonical content of every known parent field except the
				// wire-only idx and the nested ownership fields). There is no
				// proven stable identity field (idx is regenerated sequentially;
				// cat/name are not unique), so preservation matches by unchanged
				// content, not identity. A unique unconsumed match is required:
				// a changed, new, reordered-differently, or duplicate item with
				// an omitted nested wrapper cannot be matched safely, so the
				// apply is refused (omission means preserve; an ambiguous mapping
				// must fail rather than be guessed). One remote item cannot
				// satisfy two patch items (consumed map).
				{{$coll.LocalName}}Consumed := make(map[int]bool, len({{$coll.LocalName}}GetItems))
				for i := range {{$coll.LocalName}}PatchItems {
					{{- $hasNested := or (.Item.Fields | hasSubItemArray) (.Item.Fields | hasItemStringArray)}}
					{{- if $hasNested}}
					// Determine whether any nested ownership field is omitted for
					// this patch item; only then is preservation needed.
					{{$coll.LocalName}}OmitAny := false
					{{- range .Item.Fields}}
					{{- if or (eq .Kind "array") (eq .Kind "string_array")}}
					if len({{$coll.LocalName}}PatchItems[i].{{.GoName}}) == 0 {
						{{$coll.LocalName}}OmitAny = true
					}
					{{- end}}
					{{- end}}
					{{- if .Item.HasPreserveFromGet}}
					{{$coll.LocalName}}OmitAny = true
					{{- end}}
					if {{$coll.LocalName}}OmitAny && len({{$coll.LocalName}}GetItems) > 0 {
						// Only preserve when the fresh GET has existing items to
						// preserve from. When the remote collection is empty,
						// every patch item is new: an omitted nested wrapper has
						// nothing to preserve and stays omitted (no refusal).
						match, matchIndex, ok := {{$coll.CodecPrefix}}MatchGetItem({{$coll.LocalName}}PatchItems[i], {{$coll.LocalName}}GetItems, {{$coll.LocalName}}Consumed)
						if !ok {
							diagnostics.AddError("Cannot preserve omitted nested array",
								fmt.Sprintf("configs.{{.WireName}}.item[%d] omits a nested ownership wrapper, but the provider could not uniquely match the parent item to the fresh GET by its unchanged content. Apply was refused because omission means preserve. Configure each omitted wrapper explicitly: an empty wrapper sends []; a populated wrapper replaces the array.", i+1))
							return diagnostics
						}
						{{$coll.LocalName}}Consumed[matchIndex] = true
						{{- range .Item.Fields}}
						{{- if or (eq .Kind "array") (eq .Kind "string_array")}}
						if len({{$coll.LocalName}}PatchItems[i].{{.GoName}}) == 0 {
							if subRaw, ok := match["{{.WireName}}"]; ok && len(subRaw) > 0 {
								{{$coll.LocalName}}PatchItems[i].{{.GoName}} = subRaw
							}
						}
						{{- else if .ComputedOnly}}
						if subRaw, ok := match["{{.WireName}}"]; ok && len(subRaw) > 0 && !{{$r.LowerCamel}}JSONNull(subRaw) {
							var {{.Name}}Grafted string
							if err := json.Unmarshal(subRaw, &{{.Name}}Grafted); err == nil {
								{{$coll.LocalName}}PatchItems[i].{{.GoName}} = &{{.Name}}Grafted
							}
						}
						{{- end}}
						{{- end}}
					}
					{{- end}}
				}
			}
		}
		{{- if .WireParent}}
		setNested("{{.WireParent}}", "{{.WireName}}", {{$coll.LocalName}}PatchItems)
		{{- else}}
		set("{{.WireName}}", {{$coll.LocalName}}PatchItems)
		{{- end}}
		{{- else}}
		{{- if .WireParent}}
		setNested("{{.WireParent}}", "{{.WireName}}", patch.{{.GoName}}.Items)
		{{- else}}
		set("{{.WireName}}", patch.{{.GoName}}.Items)
		{{- end}}
		{{- end}}
	}
	{{- end}}
	{{- range .Resource.ScalarStringArrays}}
	if patch.{{.GoName}}.Set {
		set("{{.WireName}}", patch.{{.GoName}}.Items)
	}
	{{- end}}
	return diagnostics
}

