// {{$coll.CodecPrefix}}MatchGetItem finds the unique unconsumed fresh-GET item
// whose "unchanged projection" equals the patch item's projection, returning
// the matching raw GET item and its index. The projection is the canonical
// content of every known parent field EXCEPT the wire-only idx and the nested
// ownership fields (array / string_array / object) — i.e. the scalar fields the
// user controls. There is no proven stable identity field (idx is regenerated
// sequentially; cat/name are not unique identifiers), so preservation matches
// by unchanged content, not identity. A unique unconsumed match is required:
// zero or multiple matches return false so the caller can fail closed (omission
// means preserve; an ambiguous or changed/new item cannot be matched safely).
// The caller tracks consumed indices so one remote item cannot satisfy two
// patch items. The comparison marshals the projection maps to JSON (Go sorts
// map keys), so byte-equality is a stable canonical check.
func {{$coll.CodecPrefix}}MatchGetItem(item {{.CodecPrefix}}WireItem, getItems []map[string]json.RawMessage, consumed map[int]bool) (map[string]json.RawMessage, int, bool) {
	patchJSON, err := json.Marshal(item)
	if err != nil {
		return nil, -1, false
	}
	var patchMap map[string]json.RawMessage
	if err := json.Unmarshal(patchJSON, &patchMap); err != nil {
		return nil, -1, false
	}
	// The wire-only idx (present in the raw GET item; regenerated sequentially
	// on write) is not part of the unchanged projection; strip it along with
	// the nested-array/object fields.
	delete(patchMap, "idx")
	{{- range .Item.Fields}}
	{{- if or (eq .Kind "array") (eq .Kind "string_array") (eq .Kind "object")}}
	delete(patchMap, "{{.WireName}}")
	{{- end}}
	{{- if .ComputedOnly}}
	delete(patchMap, "{{.WireName}}")
	{{- end}}
	{{- end}}
	// Canonicalize scalar fields using each field's reviewed default semantics:
	// a scalar whose value equals its reviewed default is equivalent to an
	// absent field, so drop default-valued scalars from the projection on both
	// sides. This makes an unchanged item match whether the backend sent the
	// default explicitly or omitted it (e.g. known_bots status default true,
	// parameter_validation block_period default 60, rewriting protocol HTTP).
	{{- range .Item.Fields}}
	{{- if eq .Kind "boolean"}}
	if bytes.Equal(bytes.TrimSpace(patchMap["{{.WireName}}"]), []byte("{{providerBoolDefault .ProviderDefaultBool}}")) {
		delete(patchMap, "{{.WireName}}")
	}
	{{- else if eq .Kind "integer"}}
	if bytes.Equal(bytes.TrimSpace(patchMap["{{.WireName}}"]), []byte("{{providerIntDefault .ProviderDefaultInt}}")) {
		delete(patchMap, "{{.WireName}}")
	}
	{{- else if eq .Kind "string"}}
	if bytes.Equal(bytes.TrimSpace(patchMap["{{.WireName}}"]), []byte({{providerStringDefaultJSON .ProviderDefaultString}})) {
		delete(patchMap, "{{.WireName}}")
	}
	{{- end}}
	{{- end}}
	patchSig, err := json.Marshal(patchMap)
	if err != nil {
		return nil, -1, false
	}
	var match map[string]json.RawMessage
	matchIndex := -1
	matches := 0
	for gi, get := range getItems {
		if consumed[gi] {
			continue
		}
		getMap := make(map[string]json.RawMessage, len(get))
		for k, v := range get {
			getMap[k] = v
		}
		delete(getMap, "idx")
		{{- range .Item.Fields}}
		{{- if or (eq .Kind "array") (eq .Kind "string_array") (eq .Kind "object")}}
		delete(getMap, "{{.WireName}}")
		{{- end}}
		{{- if .ComputedOnly}}
		delete(getMap, "{{.WireName}}")
		{{- end}}
		{{- end}}
		{{- range .Item.Fields}}
		{{- if eq .Kind "boolean"}}
		if bytes.Equal(bytes.TrimSpace(getMap["{{.WireName}}"]), []byte("{{providerBoolDefault .ProviderDefaultBool}}")) {
			delete(getMap, "{{.WireName}}")
		}
		{{- else if eq .Kind "integer"}}
		if bytes.Equal(bytes.TrimSpace(getMap["{{.WireName}}"]), []byte("{{providerIntDefault .ProviderDefaultInt}}")) {
			delete(getMap, "{{.WireName}}")
		}
		{{- else if eq .Kind "string"}}
		if bytes.Equal(bytes.TrimSpace(getMap["{{.WireName}}"]), []byte({{providerStringDefaultJSON .ProviderDefaultString}})) {
			delete(getMap, "{{.WireName}}")
		}
		{{- end}}
		{{- end}}
		getSig, err := json.Marshal(getMap)
		if err != nil {
			continue
		}
		if bytes.Equal(patchSig, getSig) {
			match = get
			matchIndex = gi
			matches++
		}
	}
	if matches != 1 {
		return nil, -1, false
	}
	return match, matchIndex, true
}
{{- end}}

